{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agent-kanban-e2e",
  "main": "../../apps/web/worker/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "REALMROOT_ISSUER": "https://id.realmroot.dev/api/auth",
    "REALMROOT_CONSOLE_URL": "https://id.realmroot.dev",
    "REALMROOT_WEB_CLIENT_ID": "e2e-web-client",
    "REALMROOT_CLI_CLIENT_ID": "e2e-cli-client"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/web/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/.well-known/*", "/share/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_RELAY", "class_name": "TunnelRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelRelay"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-kanban-db",
      "database_id": "13cdf435-a99c-4744-9eca-9ed22b232581",
      "migrations_dir": "../../apps/web/migrations"
    }
  ]
}
