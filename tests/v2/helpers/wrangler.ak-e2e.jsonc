{
  "name": "agent-kanban-v2-e2e",
  "main": "../../../apps/web/worker/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/.well-known/*", "/skills/*"]
  },
  "vars": {
    "ALLOWED_HOSTS": "127.0.0.1",
    "AK_API_URL": "http://127.0.0.1:6265",
    "AK_RESOURCE": "http://127.0.0.1:6265/api",
    "AMA_ORIGIN": "http://127.0.0.1:9",
    "AMA_RESOURCE": "http://127.0.0.1:9/api",
    "REALMROOT_ISSUER": "http://127.0.0.1:8/api/auth",
    "REALMROOT_WEB_CLIENT_ID": "ak-e2e-web",
    "REALMROOT_WEB_CLIENT_SECRET": "e2e-secret",
    "REALMROOT_CLI_CLIENT_ID": "ak-e2e-cli",
    "REALMROOT_SESSION_ENCRYPTION_KEY": "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-kanban-v2-e2e",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../../apps/web/migrations"
    }
  ]
}
