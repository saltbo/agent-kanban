{
  "name": "agent-kanban",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-first kanban board and Realmroot Resource Server",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:migrate": "tsx scripts/check-v2-upgrade.ts --local && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "tsx scripts/check-v2-upgrade.ts --remote && wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check . && pnpm run lint:spec",
    "lint:fix": "biome check --write .",
    "lint:spec": "tsx scripts/check-spec-coverage.ts",
    "format": "biome format --write .",
    "prepare": "lefthook install"
  },
  "keywords": [
    "kanban",
    "agent",
    "realmroot"
  ],
  "author": "saltbo",
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@assistant-ui/store": "0.2.13"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-diff-viewer-continued": "^4.2.0",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.10",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "^1.35.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.2",
    "lefthook": "^2.1.5",
    "miniflare": "^4.20260430.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.2",
    "wrangler": "^4.87.0"
  },
  "volta": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  }
}
